# Contrato de configuracao do docker-compose deste slice. Copie para `.env` (gitignored) e
# preencha com valores locais. Nenhum valor real deve ser commitado -- os abaixo sao
# deliberadamente obvios/falsos (ADR-0013, emenda "infraestrutura em Docker").
#
# Para gerar segredos localmente sem depender de ferramenta Unix no host Windows, use o
# `keytool` do proprio JDK 25 (chaves e certificados) ou o script em
# `scripts/gerar-segredos-dev.ps1` (a ser criado em F1/F7).

# --- PostgreSQL (container postgres:18) ---
POSTGRES_SUPERUSER_PASSWORD=troque-esta-senha-do-superuser

# servico-carteira-clientes: armazenamento privado proprio (ADR-0014). Dois papeis distintos --
# migrator tem DDL, app so tem DML -- para que o processo online nunca precise de privilegio de
# schema (ADR-0014, "privilegio por processo").
CARTEIRA_DB_NOME=carteira_clientes_db
CARTEIRA_DB_MIGRATOR_USUARIO=carteira_migrator
CARTEIRA_DB_MIGRATOR_SENHA=troque-esta-senha-migrator
CARTEIRA_DB_APP_USUARIO=carteira_app
CARTEIRA_DB_APP_SENHA=troque-esta-senha-app

# --- Redis (container redis:8) -- sessao privada do bff-gerente (ADR-0015) ---
REDIS_SENHA=troque-esta-senha-redis

# --- servidor-autorizacao (Spring Authorization Server) ---
# Chave RSA de assinatura dos tokens, PEM PKCS#8 em uma linha com \n literais, ou caminho para
# volume montado. Gerar localmente -- nunca reutilizar entre ambientes.
AUTH_SERVER_CHAVE_ASSINATURA_PRIVADA=
AUTH_SERVER_CHAVE_ASSINATURA_PUBLICA=

# Client confidencial usado pelo bff-gerente para Authorization Code + PKCE e Token Exchange.
AUTH_SERVER_BFF_CLIENT_ID=bff-gerente
AUTH_SERVER_BFF_CLIENT_SECRET=troque-este-client-secret

# Usuarios de demonstracao (gerentes), formato "login:senha:papel;login:senha:papel".
AUTH_SERVER_USUARIOS_DEMO=gerente.a:troque-senha-a:GERENTE_RELACIONAMENTO;gerente.b:troque-senha-b:GERENTE_RELACIONAMENTO

# --- bff-gerente ---
BFF_SESSAO_SEGREDO=troque-este-segredo-de-sessao

# --- nginx / TLS local ---
# Certificado autoassinado de desenvolvimento, gerado localmente (ver scripts/), gitignored.
# Necessario para que o cookie `Secure` do AC19 seja exercitado de verdade, nao encenado.
NGINX_TLS_CERT_PATH=./certs/dev-localhost.crt
NGINX_TLS_KEY_PATH=./certs/dev-localhost.key
