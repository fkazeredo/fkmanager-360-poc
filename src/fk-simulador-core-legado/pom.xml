<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fkmanager360</groupId>
        <artifactId>fkmanager-360-poc</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>fk-simulador-core-legado</artifactId>
    <packaging>jar</packaging>

    <name>fk-simulador-core-legado</name>
    <description>
        Sistema externo simulado (nao e um bounded context deste repositorio). Expoe, sobre
        transporte HTTP simples, um contrato deliberadamente host-centric e ficticio da POC:
        campos abreviados, codigos numericos, datas yyyyMMdd, zero-padding e COD-RET/MSG-RET
        proprios (ADR-0005). Capacidades: consulta em lote dos dados mestres do Cliente, consulta
        das contas de um Cliente e consulta dos dados de credito de uma conta -- cada uma
        consumida pela ACL do contexto a que aquele dado pertence (ADR-0004).
    </description>

    <properties>
        <springdoc.version>3.0.0</springdoc.version>
    </properties>

    <dependencies>
        <!-- OpenAPI gerado a partir das anotacoes dos controllers/DTOs de adapter/in/web (ADR-0019):
             o contrato canonico e src/fk-simulador-core-legado/openapi.yaml, regenerado a partir de
             /v3/api-docs.yaml enquanto o servico roda (docker compose ou local), nunca escrito a
             mao. Sem <version>: nao coberto pelo BOM do Spring Boot ainda, fixado explicitamente. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
            Spring Boot 4 fatiou spring-boot-starter-test: o slice de @WebMvcTest agora e um
            starter proprio, que ja traz spring-boot-starter-test (JUnit, AssertJ, Mockito)
            transitivamente.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Lombok vive so em adapter/** e config/** (lombok.config na raiz) - domain/** e
             application/** continuam Java puro, sem processador de anotacao (ADR-0020). Sem
             <version>: o BOM do Spring Boot 4.1.1 ja gerencia 1.18.46, a mesma versao que
             annotationProcessorPaths (pom raiz) fixa para o compiler plugin. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>fk-simulador-core-legado</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
