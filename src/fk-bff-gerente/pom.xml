<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fkmanager360</groupId>
        <artifactId>fkmanager-360-poc</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>fk-bff-gerente</artifactId>
    <packaging>jar</packaging>

    <name>fk-bff-gerente</name>
    <description>
        Fronteira web e de composicao (ADR-0013) -- nao e um bounded context. OAuth2 confidential
        client conduzindo Authorization Code + PKCE + OIDC; sessao server-side em Redis (ADR-0015).
        O browser recebe apenas o cookie de sessao: nunca access token, refresh token ou client
        secret. Nao implementa regra de credito, nao fala com o simulador-core-legado e nao
        substitui a autorizacao de recurso feita pelos servicos (ADR-0004, ADR-0007).
    </description>

    <properties>
        <wiremock.version>3.13.2</wiremock.version>
    </properties>

    <!--
        Mesmo alinhamento de jetty que os demais modulos com WireMock precisam: wiremock-jetty12
        pede jetty-ee10-bom 12.0.30 internamente, mas spring-boot-dependencies ja importa
        jetty-bom/jetty-ee11-bom 12.1.12, e as duas versoes sao binariamente incompativeis.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.eclipse.jetty.ee10</groupId>
                <artifactId>jetty-ee10-bom</artifactId>
                <version>12.1.12</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-session-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- S6 da composicao: os dois Resource Servers e o simulador representados por mock HTTP
             server real, para que "o BFF nao chama o Core" (AC30) seja uma asercao sobre trafego
             observado, e nao sobre leitura de codigo. -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-jetty12</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>fk-bff-gerente</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
