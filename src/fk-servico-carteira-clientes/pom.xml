<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fkmanager360</groupId>
        <artifactId>fkmanager-360-poc</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>fk-servico-carteira-clientes</artifactId>
    <packaging>jar</packaging>

    <name>fk-servico-carteira-clientes</name>
    <description>
        Contexto CarteiraClientes: autoridade sobre a associacao atual GerenteRelacionamento -
        Cliente. Neste ticket, expoe a listagem paginada da carteira do gerente autenticado,
        composta com os dados mestres do Cliente lidos do simulador-core-legado pela ACL propria
        deste contexto (ADR-0004). Nao e fachada financeira: nao conhece LimiteChequeEspecial
        (ADR-0004, AC30).
    </description>

    <properties>
        <wiremock.version>3.13.2</wiremock.version>
    </properties>

    <!--
        wiremock-jetty12 pede jetty-ee10-bom 12.0.30 internamente, mas spring-boot-dependencies ja
        importa jetty-bom/jetty-ee11-bom 12.1.12. Sem isto, jetty-server (12.1.12, ganho por estar
        mais perto na arvore) e jetty-ee10-servlet (12.0.30, sem outro gerenciador) ficam
        binariamente incompativeis. Alinha jetty-ee10 na mesma versao.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.eclipse.jetty.ee10</groupId>
                <artifactId>jetty-ee10-bom</artifactId>
                <version>12.1.12</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Migracao embutida (ADR-0014, emenda 2026-09-02): Flyway roda no boot, com
             spring.flyway.* apontando para a credencial de DDL (migrator), distinta de
             spring.datasource.* (credencial de DML da aplicacao, usada pelo JdbcClient). Spring
             Boot resolve as duas como DataSources independentes, e a query da aplicacao nunca usa
             a credencial de DDL.

             Boot 4 fatiou o autoconfigure de Flyway para fora de spring-boot-autoconfigure, no
             mesmo padrao de spring-boot-starter-webmvc-test/security-test: flyway-core sozinho
             traz a biblioteca, mas nao FlywayAutoConfiguration. Sem o starter, Flyway nunca e
             considerado pelo autoconfigure e a migracao simplesmente nao roda, em silencio. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Testes: Spring Boot 4 fatiou spring-boot-starter-test em starters por slice. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- S4: mesmo HTTP client e adapter de producao contra um mock HTTP server real.
             wiremock-jetty12 (nao wiremock puro) traz a implementacao de HttpServerFactory que a
             versao 3.13 passou a exigir como extensao separada. -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-jetty12</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- S8: regra de dependencia desde o primeiro codigo. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>fk-servico-carteira-clientes</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
