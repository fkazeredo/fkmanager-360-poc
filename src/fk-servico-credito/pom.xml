<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fkmanager360</groupId>
        <artifactId>fkmanager-360-poc</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>fk-servico-credito</artifactId>
    <packaging>jar</packaging>

    <name>fk-servico-credito</name>
    <description>
        Contexto Credito, dono semantico do LimiteChequeEspecial. Expoe a consulta do
        LimiteChequeEspecialVigente que o CoreLegado reconhece agora, lido pela ACL propria deste
        contexto (ADR-0004), sempre depois de CarteiraClientes confirmar o direito de atendimento
        (ADR-0007). A partir de #0003, tambem registra a SolicitacaoAumentoLimite e a decisao
        automatica: credito_db nasce aqui, com Flyway embutido e credencial de DDL separada da
        credencial de DML da aplicacao (ADR-0010, ADR-0014).
    </description>

    <properties>
        <wiremock.version>3.13.2</wiremock.version>
    </properties>

    <!--
        Mesmo alinhamento de jetty que fk-servico-carteira-clientes precisa: wiremock-jetty12 pede
        jetty-ee10-bom 12.0.30 internamente, mas spring-boot-dependencies ja importa
        jetty-bom/jetty-ee11-bom 12.1.12, e as duas versoes sao binariamente incompativeis.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.eclipse.jetty.ee10</groupId>
                <artifactId>jetty-ee10-bom</artifactId>
                <version>12.1.12</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!-- Tambem OAuth client: o Token Exchange encadeado para servico-carteira-clientes
             (ADR-0015) usa a infraestrutura padrao do Spring Security, sem cache proprio. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- credito_db nasce neste ticket (#0003, ADR-0010, ADR-0014): primeiro comportamento com
             estado duravel de Credito. Migracao embutida (ADR-0014, emenda 2026-09-02): Flyway
             roda no boot com spring.flyway.* (credencial migrator, DDL), independente do
             DataSource de spring.datasource.* (credencial app, DML). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- Spring Data JPA/Hibernate e o padrao de persistencia deste modulo a partir deste
             refactor (adapter/out/persistence/**). MANTIDO junto com spring-boot-starter-jdbc
             logo abaixo: TX2 continua usando JdbcClient nativo so para o SELECT ... FOR UPDATE
             NOWAIT (ver Javadoc de CreditoPersistenceOperations) - as duas tecnologias
             compartilham a mesma transacao/DataSource. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Exceção justificada (nao superseded pelo starter de JPA acima, ao contrario de
             carteira-clientes): o lock nativo de TX2 (FOR UPDATE NOWAIT) usa JdbcClient
             diretamente, dentro da mesma transacao que o Hibernate compartilha. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- Lombok vive so em adapter/** e config/** (lombok.config na raiz) - domain/** e
             application/** continuam Java puro, sem processador de anotacao (ADR-0020). Sem
             <version>: o BOM do Spring Boot 4.1.1 ja gerencia 1.18.46, a mesma versao que
             annotationProcessorPaths (pom raiz) fixa para o compiler plugin. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Escopo compile (nao runtime, ao contrario de carteira-clientes): o guardrail de
             concorrencia do adapter de persistencia (SolicitacoesAumentoLimitePort, plano #0003)
             inspeciona org.postgresql.util.PSQLException.getServerErrorMessage().getConstraint()
             para identificar, so para log/diagnostico, qual constraint colidiu apos um conflito de
             TX1 - a classificacao da resposta em si nunca depende disso (a releitura do registro
             de idempotencia decide). Isso exige o driver no classpath de compilacao deste modulo. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- Testes: Spring Boot 4 fatiou spring-boot-starter-test em starters por slice. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- S3: persistencia contra PostgreSQL real (ADR-0018 - H2 nao substitui). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- S5: smoke contra o simulador-core-legado real, sem duplicar a matriz patologica de S4. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- S4/S6: mesmo HTTP client e adapter de producao contra um mock HTTP server real. -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-jetty12</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- S8: regra de dependencia desde o primeiro codigo. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>fk-servico-credito</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
