# Configuracao raiz do Lombok, valida para todos os modulos JVM abaixo de src/.
#
# Lombok e ferramenta de INFRAESTRUTURA: vale em adapter/** e config/**, e nunca dentro do
# hexagono. domain/** e application/** continuam Java puro, sem processador de anotacao --
# hexagonal nao tem Lombok como elemento nativo, e o interior do hexagono e justamente onde
# a ausencia de dependencia externa e a propriedade que se quer preservar (ADR-0020).
config.stopBubbling = true

# Faz o Lombok marcar cada membro que ele gera com @lombok.Generated (retencao CLASS).
# Serve a dois propositos: ferramentas de cobertura ignoram codigo gerado, e a fronteira
# "hexagono nao usa Lombok" passa a ter chance de ser verificada por bytecode em vez de
# convencao.
lombok.addLombokGeneratedAnnotation = true

# Sem isto, @RequiredArgsConstructor descartaria o @Qualifier declarado no campo ao gerar o
# parametro do construtor, e a injecao passaria a resolver por tipo -- silenciosamente errada
# nos adapters que tem mais de um RestClient no contexto. Com a copia habilitada, os adapters
# de ACL do CoreLegado podem usar a anotacao sem o onConstructor_ ilegivel.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
